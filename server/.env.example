PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/test?retryWrites=true&w=majority
# Optional if the database name is not in MONGO_URI (Mongoose default is "test")
MONGO_DB_NAME=test
JWT_SECRET=use-a-long-random-string-here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Scraper / sync scheduler
SYNC_ENABLED=true
SYNC_CRON=0 3 1 * *
SYNC_PYTHON=python
SYNC_TIMEOUT_MS=7200000
SYNC_CLEANER_WORKERS=10

# Cloudinary (required for new image uploads during sync)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
